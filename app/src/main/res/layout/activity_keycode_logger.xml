<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/black">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logger_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logger_subtitle"
        android:textSize="12sp"
        android:textColor="@color/subtitle_gray"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.62"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/serviceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:padding="4dp" />

            <Button
                android:id="@+id/accessibilitySettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Accessibility settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volume up action"
                android:textColor="@color/white" />
            <Spinner
                android:id="@+id/volumeUpAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volume down action"
                android:textColor="@color/white" />
            <Spinner
                android:id="@+id/volumeDownAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Headset button single press action"
                android:textColor="@color/white" />
            <Spinner
                android:id="@+id/headsetAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/volumeEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use volume keys for scrolling"
                android:textColor="@color/white"
                android:checked="true" />

            <CheckBox
                android:id="@+id/useGestures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use gestures for adjustable distance and speed"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/distanceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />
            <SeekBar
                android:id="@+id/distanceSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="65" />

            <TextView
                android:id="@+id/speedLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />
            <SeekBar
                android:id="@+id/speedSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="700" />

            <TextView
                android:id="@+id/timingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />
            <SeekBar
                android:id="@+id/doubleTapSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="520" />
            <SeekBar
                android:id="@+id/holdSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1150" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Power button selection is blocked by Android. Use a headset control assigned to Select."
                android:textColor="@color/subtitle_gray"
                android:padding="4dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/clearButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clear_log" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.38"
        android:background="@color/log_background"
        android:padding="8dp">

        <TextView
            android:id="@+id/logTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/log_text"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
